# Copy to .env and fill secrets. Never commit real passwords.

NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_API_BASE_URL=

# MongoDB Atlas
MONGODB_URI=mongodb+srv://neamul_db_user:YOUR_DB_PASSWORD@cluster0.avcswji.mongodb.net/arins_study_diary?retryWrites=true&w=majority
MONGODB_DB_NAME=arins_study_diary

# Invite-only auth (Lambda)
APP_JWT_SECRET=change-me-to-a-long-random-string
ARIN_EMAIL=arin@example.com
ARIN_PASSWORD=change-me-arin
EMON_EMAIL=emon@example.com
EMON_PASSWORD=change-me-emon

# Bedrock / CORS (Lambda)
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
AWS_REGION=ap-south-1
ALLOWED_ORIGIN=http://localhost:3000

# SMTP (AWS SES Mail Manager ingress / other SMTP) — reminders + plan/withdraw alerts
SMTP_HOST=xxxx.mail-manager-smtp.amazonaws.com
SMTP_PORT=587
SMTP_USER=YOUR_SMTP_USERNAME
SMTP_PASS=YOUR_SMTP_PASSWORD
SMTP_FROM="Arin's Study Diary <verified@example.com>"
# Optional: protect POST /internal/tick-reminders when using an external cron
REMINDER_CRON_SECRET=
